# Plantilla: la imagen de nginx corre envsubst sobre /etc/nginx/templates/*.template
# al arrancar y solo reemplaza variables que existan en el entorno, así que $uri
# y $http_* sobreviven intactos.
#
# El puerto es variable porque Railway lo inyecta en $PORT y cambia entre
# despliegues; con "listen 80" fijo el contenedor arranca pero queda inalcanzable.
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # React Router maneja las rutas del cliente: cualquier ruta desconocida
  # devuelve el index en lugar de un 404 del servidor.
  location / {
    try_files $uri $uri/ /index.html;
  }

  location ~* \.(js|css|woff2?|svg|png|jpg|ico)$ {
    expires 30d;
    add_header Cache-Control "public, immutable";
  }
}
