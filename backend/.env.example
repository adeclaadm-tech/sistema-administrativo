# ---------------------------------------------------------------------------
# Backend ADECLA · copia este archivo a .env y llena los valores
# ---------------------------------------------------------------------------

# Aplicación
APP_ENV=development           # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Local con docker-compose (el host es el nombre del servicio, no localhost):
DATABASE_URL=postgresql+psycopg://adecla:adecla@db:5432/adecla
#
# Neon:     postgresql://usuario:clave@ep-xxx.us-east-2.aws.neon.tech/adecla?sslmode=require
# Supabase: postgresql://postgres:clave@db.xxx.supabase.co:5432/postgres
# Railway:  ${{Postgres.DATABASE_URL}}   (referencia entre servicios en Railway)
#
# Pega la URL tal como la entrega el proveedor: el backend le pone el driver
# psycopg solo.

# ---------------------------------------------------------------------------
# Autenticación
# ---------------------------------------------------------------------------
# Genera una llave nueva por entorno:  openssl rand -hex 32
JWT_SECRET=cambiame-en-produccion-con-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_MINUTES=20160

# ---------------------------------------------------------------------------
# CORS — dominios del frontend, separados por coma
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# En producción:
# CORS_ORIGINS=https://afiliados.adecla.do,https://adecla-afiliados.vercel.app

# ---------------------------------------------------------------------------
# Storage de documentos (compatible con S3 — Cloudflare R2 por defecto)
# ---------------------------------------------------------------------------
# Los archivos NUNCA se guardan en el disco del servidor: el contenedor es
# efímero y el comprobante de un pago tiene que sobrevivir al próximo deploy.
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=adecla-documentos
# Dominio público del bucket. Si lo dejas vacío, el backend firma URLs
# temporales y el bucket puede seguir siendo privado (recomendado).
S3_PUBLIC_BASE_URL=
S3_SIGNED_URL_TTL=3600
MAX_UPLOAD_MB=10
#
# Otros proveedores compatibles, solo cambia el endpoint:
# AWS S3:        (deja S3_ENDPOINT_URL vacío y pon la región real)
# DO Spaces:     https://nyc3.digitaloceanspaces.com
# MinIO local:   http://minio:9000

# ---------------------------------------------------------------------------
# Reglas de negocio
# ---------------------------------------------------------------------------
CUOTA_ANUAL_DEFAULT=45000
MONEDA=DOP
DIAS_AVISO_VENCIMIENTO=30
